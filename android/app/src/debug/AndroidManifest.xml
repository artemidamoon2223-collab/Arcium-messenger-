<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only. A provider in its own process that the S2-B2
  instrumentation tests use to kill a process in the middle of the messaging
  lifecycle. Absent from release builds.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <provider
            android:name="com.arcium.messenger.debug.CrashVictimProvider"
            android:authorities="com.arcium.messenger.debug.victim"
            android:exported="false"
            android:process=":victim" />
    </application>
</manifest>
